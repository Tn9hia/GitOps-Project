# {{ ansible_managed }}
# nginx site config — serves aptly's published repo

server {
    listen 80;
    server_name _;

    root {{ aptly_root_dir }}/public;
    autoindex on;

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 443 ssl;
    server_name _;
    ssl_certificate {{ aptly_ssl_certificate }};
    ssl_certificate_key {{ aptly_ssl_certificate_key }};

    # Optimized SSL Protocols and Cipher Suites
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # Performance Enhancements (SSL Session Caching)
    ssl_session_timeout 1d;
    ssl_session_cache shared:Mozilla-SSL:10m;
    ssl_session_tickets off;

    root {{ aptly_root_dir }}/public;
    autoindex on;

    location / {
        try_files $uri $uri/ =404;
    }
}