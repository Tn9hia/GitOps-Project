# cilium-values.yaml
kubeProxyReplacement: true

k8sServiceHost: "{{ hostvars[groups['haproxy'][0]]['ansible_host'] }}"
k8sServicePort: "{{ cilium_k8s_service_port }}"

ipam:
  mode: cluster-pool
  operator:
    clusterPoolIPv4PodCIDRList:
{% for cidr in cilium_pod_cidrs %}
      - "{{ cidr }}"
{% endfor %}
    clusterPoolIPv4MaskSize: {{ cilium_pod_cidr_mask_size }}

routingMode: {{ cilium_routing_mode }}
tunnelProtocol: {{ cilium_tunnel_protocol }}

bpf:
  masquerade: true

enableIPv4Masquerade: true

operator:
  replicas: {{ cilium_operator_replicas }}
  prometheus:
    enabled: true

prometheus:
  enabled: true

hubble:
  enabled: true
  relay:
    enabled: true
  ui:
    enabled: true
  metrics:
    enabled:
{% for metric in cilium_hubble_metrics %}
      - {{ metric }}
{% endfor %}
